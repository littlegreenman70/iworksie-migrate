#: src/Receiver/Preflight.php:132
#: src/Receiver/Preflight.php:141
msgid "File name Unicode forms"
msgstr ""

#: src/Receiver/Preflight.php:133
msgid "The PHP intl extension is missing on at least one site, so Unicode file name forms cannot be detected."
msgstr ""

#: src/Receiver/Preflight.php:135
msgid "A macOS site often stores NFD file names while a Linux site stores NFC. The same visible name can then look like two different files."
msgstr ""

#: src/Receiver/Preflight.php:136
msgid "Install the intl extension where possible. This version does not rewrite names; it copies and compares them as raw bytes."
msgstr ""

#: src/Receiver/Preflight.php:142
msgid "File names are copied as raw bytes. This version detects non-NFC names but does not rewrite them."
msgstr ""

#: src/Receiver/Preflight.php:144
msgid "A macOS giver (NFD) and a Linux receiver (NFC) can keep lookalike duplicates or fail a later verify if tools normalize names differently."
msgstr ""

#: src/Receiver/Preflight.php:145
msgid "Prefer matching Unicode forms on both filesystems when you can. No action is required for ASCII-only Media Libraries."
msgstr ""

